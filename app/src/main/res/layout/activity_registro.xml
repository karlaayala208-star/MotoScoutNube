<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp"
        tools:context=".Registro">

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/andada"
            android:text="Registrarse"
            android:textAlignment="center"
            android:textColor="@color/txtbtn"
            android:textSize="48sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/user"
            android:background="@color/botonsecun"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSeleccionarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegir Foto"
            android:onClick="seleccionarImagen"
            android:backgroundTint="@color/fondo"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/ivFotoPerfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/TxtNomb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:ems="10"
            android:hint="Nombre"
            android:inputType="text"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@+id/TxtApell"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSeleccionarFoto" />

        <EditText
            android:id="@+id/TxtApell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/black"
            android:ems="10"
            android:hint="Apellido"
            android:inputType="text"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/TxtNomb"
            app:layout_constraintTop_toTopOf="@+id/TxtNomb" />

        <EditText
            android:id="@+id/TxtEm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:ems="10"
            android:hint="Correo electronico"
            android:inputType="textEmailAddress"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/TxtApell"
            app:layout_constraintStart_toStartOf="@+id/TxtNomb"
            app:layout_constraintTop_toBottomOf="@+id/TxtNomb" />

        <EditText
            android:id="@+id/TxtNumb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:ems="10"
            android:hint="Numero de telefono"
            android:inputType="number"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/TxtEm"
            app:layout_constraintStart_toStartOf="@+id/TxtEm"
            app:layout_constraintTop_toBottomOf="@+id/TxtEm" />

        <EditText
            android:id="@+id/TxtPass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:ems="10"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/TxtNumb"
            app:layout_constraintStart_toStartOf="@+id/TxtNumb"
            app:layout_constraintTop_toBottomOf="@+id/TxtNumb" />

        <EditText
            android:id="@+id/TxtDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:ems="10"
            android:hint="Fecha de nacimiento"
            android:inputType="date"
            android:focusable="false"
            android:clickable="true"
            android:textColorHint="@color/black"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/TxtPass"
            app:layout_constraintStart_toStartOf="@+id/TxtPass"
            app:layout_constraintTop_toBottomOf="@+id/TxtPass" />

        <EditText
            android:id="@+id/TxtExperiencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Años de experiencia"
            android:inputType="number"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/black"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/TxtDate"
            app:layout_constraintStart_toStartOf="@+id/TxtDate"
            app:layout_constraintEnd_toEndOf="@+id/TxtDate" />

        <Button
            android:id="@+id/btnSeleccionarUbicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Seleccionar Ubicación del Taller"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:onClick="abrirSelectorMapa"
            android:backgroundTint="@color/btn"
            android:fontFamily="@font/andada"
            app:layout_constraintTop_toBottomOf="@+id/TxtExperiencia"
            app:layout_constraintStart_toStartOf="@+id/TxtExperiencia"
            app:layout_constraintEnd_toEndOf="@+id/TxtExperiencia" />

        <TextView
            android:id="@+id/tvCoordenadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ubicación no seleccionada"
            android:visibility="gone"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/btnSeleccionarUbicacion"
            app:layout_constraintStart_toStartOf="@+id/btnSeleccionarUbicacion"
            app:layout_constraintEnd_toEndOf="@+id/btnSeleccionarUbicacion" />

        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/fondo"
            android:fontFamily="@font/baloo_bhaijaan"
            android:onClick="Inicio"
            android:text="Crear cuenta"
            android:textColor="@color/texto"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/tvCoordenadas"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/TxtUbicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>